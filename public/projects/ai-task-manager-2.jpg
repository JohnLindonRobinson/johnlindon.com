<!-- Add is-scrolling class to navbar_component for styles when scrolled -->
<script>
    if (!document.querySelector(".navbar_component#dark")) {
        ScrollTrigger.create({
            trigger: ".main-wrapper",
            start: "top+=20 top",
            end: "+=0",
            onEnter: () => {
                $(".navbar_component").addClass("is-scrolling");
            },
            onEnterBack: () => {
                $(".navbar_component").removeClass("is-scrolling");
            }
        });
    }
</script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const overlay = document.querySelector('.open-overlay');
        const bgWhite = document.querySelector('.nav-bg-white');
        let hideTimeout;

        // Function to show overlay
        function showOverlay() {
            if (hideTimeout) {
                clearTimeout(hideTimeout);
            }
            overlay.style.display = 'block';
        		bgWhite.style.display = 'block';

        // Function to hide overlay
        function hideOverlay() {
            hideTimeout = setTimeout(() => {
                overlay.style.display = 'none';
                bgWhite.style.display = 'none';
            }, 0);
        }

        $('.w-dropdown-toggle').on('mouseenter', function () {
            showOverlay();
        });

        $('.w-dropdown-list').on('mouseenter', function () {
            showOverlay();
        });

        $('.w-dropdown-toggle').on('mouseleave', function () {
            hideOverlay();
        });

        $('.w-dropdown-list').on('mouseleave', function () {
            hideOverlay();
        });

    });
</script></body></html>